# Arcade backend env
PORT=8080

# JSON state file (auto-persists; swap for a real DB in prod)
STATE_FILE=

# Source-chain (Sepolia) GameArbiter emission — backend relays authoritative
# game-end results to the worker's source contract. Leave unset to run in
# SIMULATED mode (economy works fully offline; no on-chain broadcast).
# Set all three to arm the live path:
USCTEST_SOURCE_RPC=
USCTEST_GAME_ARBITER=
# Gas payer on Sepolia — MUST be the verifier role (or the player) or GameArbiter reverts.
USCTEST_SOURCE_KEY=

# Worker reconciliation auth: when set, /api/verify requires this token via
# the `x-worker-token` header (worker must share it). Leave empty for demo.
ARCFT_WORKER_TOKEN=

# omnilearn "Arcade Intelligence" service (fire-and-forget, never blocks)
OMNI_BASE_URL=http://localhost:8081
OMNI_API_KEY=
OMNI_SERVICE=arcade-ctc
OMNI_TIMEOUT_MS=3000
