# Arcade Attestcoin worker — env
# Source chain (Sepolia)
USCTEST_SOURCE_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
USCTEST_CHAIN_KEY=1

# Creditcoin CC3 testnet
USCTEST_CC3_RPC=https://rpc.cc3-testnet.creditcoin.network
USCTEST_PROVER_URL=https://prover.cc3-testnet.creditcoin.network/
USCTEST_ATTESTATION_ORIGIN=

# Contracts
USCTEST_GAME_ARBITER=
USCTEST_SCORE_ASC=

# Backend reconciliation relay (must match backend .env)
ARCFT_BACKEND_URL=http://localhost:8080
ARCFT_BACKEND_ADDRESS=
# Optional: mirror backend ARCFT_WORKER_TOKEN so the worker can auth /api/verify
ARCFT_WORKER_TOKEN=

# Relayer wallet (gas payer on CC3 testnet)
USCTEST_RELAYER_KEY=
